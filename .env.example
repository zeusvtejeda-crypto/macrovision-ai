# =============================================
# MacroVision AI — Environment Variables
# =============================================
# Copia este archivo a .env y configura los valores

# App
NODE_ENV=development
APP_NAME=MacroVision AI
APP_VERSION=1.0.0
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://macrovision:macrovision_pass@localhost:5432/macrovision_db
DATABASE_SHADOW_URL=postgresql://macrovision:macrovision_pass@localhost:5432/macrovision_shadow

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=no-reply@macrovision.ai

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# OAuth - Apple
APPLE_CLIENT_ID=com.macrovision.ai
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./certs/apple-private-key.p8

# AI - OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000

# AI - Google Gemini (fallback)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# AI Provider priority: openai | gemini
AI_PRIMARY_PROVIDER=openai

# USDA FoodData Central
USDA_API_KEY=your-usda-api-key
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Open Food Facts (no key needed, but optional for premium)
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=price_your-monthly-price-id
STRIPE_ANNUAL_PRICE_ID=price_your-annual-price-id
STRIPE_TRIAL_DAYS=7

# AWS S3 (image storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=macrovision-ai-images
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
THROTTLE_ANALYSIS_LIMIT=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://macrovision.ai

# Admin
ADMIN_EMAIL=admin@macrovision.ai
ADMIN_PASSWORD=change-this-immediately

# Monitoring (opcional)
SENTRY_DSN=your-sentry-dsn
