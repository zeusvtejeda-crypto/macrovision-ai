# ════════════════════════════════════════════════════════
#  MacroVision AI — Variables de entorno PRODUCCIÓN
#  Copia estas variables en Railway → Variables
# ════════════════════════════════════════════════════════

# ─── Supabase (PostgreSQL) ─────────────────────────────
# Ve a: supabase.com → tu proyecto → Settings → Database
# Usa la "Connection string" con modo "Transaction" (pooled, puerto 6543)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Para migraciones usa la conexión directa (puerto 5432)
SHADOW_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ─── JWT ──────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET="GENERA_UN_SECRET_LARGO_AQUI"
JWT_REFRESH_SECRET="GENERA_OTRO_SECRET_LARGO_AQUI"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── App ──────────────────────────────────────────────
NODE_ENV="production"
PORT=3000

# CORS: URL de tu frontend en Cloudflare Pages
CORS_ORIGINS="https://macrovision.pages.dev,https://TU-DOMINIO.com"

# ─── AI (OpenAI / Gemini) ─────────────────────────────
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-1.5-flash"
AI_PRIMARY_PROVIDER="openai"

# ─── AWS S3 (para guardar imágenes) ───────────────────
# Puedes usar Supabase Storage como alternativa gratuita
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ─── Stripe (pagos) ───────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MONTHLY_PRICE_ID="price_..."
STRIPE_ANNUAL_PRICE_ID="price_..."
STRIPE_TRIAL_DAYS=7

# ─── Email (opcional) ─────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@TU-DOMINIO.com"

# ─── App URL ──────────────────────────────────────────
APP_URL="https://TU-DOMINIO.com"
API_URL="https://TU-BACKEND.railway.app"
