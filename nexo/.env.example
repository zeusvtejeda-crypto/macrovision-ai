# Públicas (van al navegador): URL y anon/publishable key de Supabase + clave pública VAPID
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICABLE
VITE_VAPID_PUBLIC_KEY=GENERADA_CON_npm_run_secrets

# Privadas (solo servidor / Vercel). NUNCA con prefijo VITE_
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
SUPABASE_SERVICE_ROLE_KEY=SOLO_EN_VERCEL_nunca_en_el_navegador
VAPID_PRIVATE_KEY=GENERADA_CON_npm_run_secrets
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
CRON_SECRET=GENERADO_CON_npm_run_secrets
