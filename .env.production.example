# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@your-rds-host:5432/macrovision?schema=public&sslmode=require
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/macrovision_test

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://your-elasticache-host:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.macrovision.ai
ADMIN_URL=https://admin.macrovision.ai

# ─── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# ─── USDA Food Data Central ───────────────────────────────────────────────────
USDA_API_KEY=your-usda-key

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=macrovision-prod-images
AWS_CLOUDFRONT_URL=https://d1234567890.cloudfront.net

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA...
SMTP_PASS=...
SMTP_FROM=noreply@macrovision.ai

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Apple OAuth ──────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=ai.macrovision.app
APPLE_TEAM_ID=...
APPLE_KEY_ID=...
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Admin Panel (NextAuth) ────────────────────────────────────────────────────
NEXTAUTH_URL=https://admin.macrovision.ai
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING
API_URL=https://api.macrovision.ai
NEXT_PUBLIC_API_URL=https://api.macrovision.ai
